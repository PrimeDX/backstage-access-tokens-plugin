    "src/cache.js",
    "src/config.js",
    "src/constants.js",
    "src/database.js",
    "src/index.d.ts",
    "src/index.js",
    "src/module.js",
    "src/permission.js",
    "src/primitives.js",
    "src/serviceTokenHandler.js",
    "src/verifyToken.js"
  ],
  "exports": {
