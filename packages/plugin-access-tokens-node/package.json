  },
  "engines": {
    "node": ">=22.0.0"
  },
  "author": "Adrian Dantas",
  "keywords": [
    "backstage",
    "backstage-plugin",
    "access-tokens",
    "node-library"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@backstage/backend-defaults": "^0.16.0",
