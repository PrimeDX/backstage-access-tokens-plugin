  "exports": {
    ".": "./src/index.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "author": "Adrian Dantas",
  "keywords": [
    "backstage",
    "backstage-plugin",
    "access-tokens",
    "frontend-plugin"
