{
  "name": "@primedx/plugin-access-tokens",
  "version": "0.2.2",
  "description": "Backstage frontend plugin for access token administration.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PrimeDX/backstage-access-tokens-plugin.git",
    "directory": "packages/plugin-access-tokens"
  },
  "backstage": {
    "role": "frontend-plugin",
    "pluginId": "access-tokens",
    "features": {
      ".": "@backstage/FrontendPlugin"
    }
  },
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "files": [
    "README.md",
    "src/components/AuditLogDialog.jsx",
    "src/components/CreateTokenDialog.jsx",
    "src/components/CreateUserTokenDialog.jsx",
    "src/components/RevokeDialog.jsx",
    "src/components/RevokeUserTokenDialog.jsx",
    "src/components/ServiceTokensFilters.jsx",
    "src/components/ServiceTokensTableView.jsx",
    "src/components/UserTokensTableView.jsx",
    "src/helpers.js",
    "src/index.d.ts",
    "src/index.js",
    "src/routes.js",
    "src/ServiceTokensPage.jsx",
    "src/UserTokensConsentPage.jsx",
    "src/userTokensConsentHelpers.js",
    "src/userTokensHelpers.js",
    "src/UserTokensPage.jsx"
